# Copy to .env.local and fill in. Never commit real values.

# Public base URL (no trailing slash). Used for canonical URLs, sitemap, OG images.
NEXT_PUBLIC_SITE_URL=https://www.example.com

# Where form submissions are forwarded (CRM / Zapier / Make / your backend).
# Optional: without it (or if it fails), submissions are saved on the server and listed at /internal/leads.
LEAD_WEBHOOK_URL=
LEAD_WEBHOOK_SECRET=

# Built-in lead storage (listed at /internal/leads).
# On Vercel: add "Upstash for Redis" from the Vercel Marketplace; it sets these two for you.
KV_REST_API_URL=
KV_REST_API_TOKEN=
# Elsewhere (own server with a persistent disk): a file. Default: .data/leads.jsonl.
LEADS_FILE=

# Set to true only on launch day: lets Google index the site (production deployment only).
SITE_LIVE=

# Analytics — loaded only after the visitor accepts analytics cookies.
NEXT_PUBLIC_GA4_ID=
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=
NEXT_PUBLIC_CLARITY_ID=

# WhatsApp number in international format without "+" (e.g. 91XXXXXXXXXX). Widget loads after consent.
NEXT_PUBLIC_WHATSAPP_NUMBER=

# Basic-auth credentials for internal pages (/brand, /internal/*).
INTERNAL_USER=
INTERNAL_PASSWORD=
