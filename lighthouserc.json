{
  "ci": {
    "collect": {
      "startServerCommand": "npx next start -p 3200",
      "startServerReadyPattern": "Ready",
      "url": [
        "http://localhost:3200/",
        "http://localhost:3200/solutions/schools",
        "http://localhost:3200/book-consultation",
        "http://localhost:3200/labs",
        "http://localhost:3200/about"
      ],
      "numberOfRuns": 3,
      "settings": { "preset": "perf", "formFactor": "mobile", "throttlingMethod": "simulate", "skipAudits": ["is-crawlable"] }
    },
    "assert": {
      "assertions": {
        "categories:performance": ["error", { "minScore": 0.85 }],
        "categories:accessibility": ["error", { "minScore": 0.95 }],
        "categories:seo": ["error", { "minScore": 0.95 }],
        "categories:best-practices": ["error", { "minScore": 0.95 }],
        "largest-contentful-paint": ["error", { "maxNumericValue": 2500 }],
        "cumulative-layout-shift": ["error", { "maxNumericValue": 0.1 }],
        "total-blocking-time": ["error", { "maxNumericValue": 200 }],
        "resource-summary:script:size": ["error", { "maxNumericValue": 180000 }],
        "resource-summary:total:size": ["warn", { "maxNumericValue": 900000 }]
      }
    },
    "upload": { "target": "temporary-public-storage" }
  }
}
